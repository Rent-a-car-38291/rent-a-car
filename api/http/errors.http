###

# Ben reserves a day far ahead (for the next requests)
POST {{baseUrl}}/cars/{{errCarId}}/reservations
Authorization: Bearer {{errBenToken}}
Content-Type: application/json

{ "date": "2099-01-01", "daypart": "EVENING" }

> {%
    client.test("201 Created", function () { client.assert(response.status === 201, "Expected 201 but got " + response.status); });
    client.global.set("errReservationId", String(response.body.id));
%}

###

# Someone else's reservation: Anna may not cancel Ben's
DELETE {{baseUrl}}/reservations/{{errReservationId}}
Authorization: Bearer {{errAnnaToken}}

> {%
    client.test("403 Forbidden", function () {
        client.assert(response.status === 403, "Expected 403 but got " + response.status);
        client.assert(response.body.error === "forbidden", "Expected error code forbidden, got " + response.body.error);
    });
%}

###

# A trip cannot start before the day of the reservation: 409
POST {{baseUrl}}/reservations/{{errReservationId}}/trip/start
Authorization: Bearer {{errBenToken}}

> {%
    client.test("409 Conflict", function () {
        client.assert(response.status === 409, "Expected 409 but got " + response.status);
        client.assert(response.body.error === "conflict", "Expected error code conflict, got " + response.body.error);
    });
%}

###

# A trip for a reservation of the future (it has to be today or earlier): 409
POST {{baseUrl}}/reservations/{{errReservationId}}/trip
Authorization: Bearer {{errBenToken}}
Content-Type: application/json

{ "distanceKm": 50, "hardAccelerations": 0, "hardBrakes": 0 }

> {%
    client.test("409 Conflict", function () {
        client.assert(response.status === 409, "Expected 409 but got " + response.status);
        client.assert(response.body.error === "conflict", "Expected error code conflict, got " + response.body.error);
    });
%}

###

