GET {{baseUrl}}/cars/{{errCarId}}/quote?distanceKm=0

> {%
    client.test("400 Bad Request", function () {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
        client.assert(response.body.error === "bad_request", "Expected error code bad_request, got " + response.body.error);
    });
%}

###

# A page size outside 1 to 100: 400
GET {{baseUrl}}/cars?limit=1000

> {%
    client.test("400 Bad Request", function () {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
        client.assert(response.body.error === "bad_request", "Expected error code bad_request, got " + response.body.error);
    });
%}

###

# A file that is not a picture: 400. The type is read from the content, so a text file named .png is refused too
POST {{baseUrl}}/cars/{{errCarId}}/images
Authorization: Bearer {{errAnnaToken}}
Content-Type: multipart/form-data; boundary=ErrBoundary

--ErrBoundary
Content-Disposition: form-data; name="file"; filename="notes.png"
Content-Type: image/png

this is only text
--ErrBoundary--

> {%
    client.test("400 Bad Request", function () {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
        client.assert(response.body.error === "bad_request", "Expected error code bad_request, got " + response.body.error);
    });
%}

###

# A route that does not exist: 404 with the same error body
GET {{baseUrl}}/no-such-route

> {%
    client.test("404 Not Found with the error body", function () {
        client.assert(response.status === 404, "Expected 404 but got " + response.status);
        client.assert(response.body.error === "not_found", "Expected not_found, got " + response.body.error);
    });
%}

### Reservations, trips and ratings

# A date in the past: 400
POST {{baseUrl}}/cars/{{errCarId}}/reservations
Authorization: Bearer {{errBenToken}}
Content-Type: application/json

{ "date": "2020-01-01", "daypart": "MORNING" }

> {%
    client.test("400 Bad Request", function () {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
        client.assert(response.body.error === "bad_request", "Expected error code bad_request, got " + response.body.error);
    });
%}

###

# A daypart that does not exist: 400
POST {{baseUrl}}/cars/{{errCarId}}/reservations
Authorization: Bearer {{errBenToken}}
Content-Type: application/json

{ "date": "2099-01-01", "daypart": "NOON" }

> {%
    client.test("400 Bad Request", function () {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
        client.assert(response.body.error === "bad_request", "Expected error code bad_request, got " + response.body.error);
    });
