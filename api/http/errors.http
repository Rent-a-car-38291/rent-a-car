###

# Ben creates an organization, and then Anna (an outsider) may not read its report: 403
POST {{baseUrl}}/organizations
Authorization: Bearer {{errBenToken}}
Content-Type: application/json

{ "name": "Ben Rent {{errRun}}" }

> {%
    client.test("201 Created", function () { client.assert(response.status === 201, "Expected 201 but got " + response.status); });
    client.global.set("errOrgId", String(response.body.id));
%}

###

GET {{baseUrl}}/organizations/{{errOrgId}}/report
Authorization: Bearer {{errAnnaToken}}

> {%
    client.test("403 Forbidden for an outsider", function () {
        client.assert(response.status === 403, "Expected 403 but got " + response.status);
        client.assert(response.body.error === "forbidden", "Expected error code forbidden, got " + response.body.error);
    });
%}

###

# Ben is the last admin: he cannot delete his account
DELETE {{baseUrl}}/accounts/{{errBenId}}
Authorization: Bearer {{errBenToken}}

> {%
    client.test("409 Conflict", function () {
        client.assert(response.status === 409, "Expected 409 but got " + response.status);
    });
%}
