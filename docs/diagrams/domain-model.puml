@startuml
' Analysis view: the domain as agreed in the backlog, including parts that aren't built yet.
' For what the code looks like today, see the class-*.puml diagrams.
hide empty members

enum Transmission {
  Manual
  Automatic
}

' Rented is gone: whether a car is rented depends on the daypart (#16).
enum CarStatus {
  Available
  Maintenance
}

enum BodyStyle {
  Hatchback
  SUV
  Sedan
  Stationwagon
  Cabrio
  Coupe
  MPV
  Other
}

enum FuelType {
  Petrol
  Diesel
  LPG
}

enum Daypart {
  MORNING : 06:00-12:00
  AFTERNOON : 12:00-18:00
  EVENING : 18:00-24:00
}

enum ReservationStatus {
  RESERVED
  COMPLETED
  CANCELLED
}

enum Role {
  Admin
  Member
}

class Location {
  + latitude : Double
  + longitude : Double
  + distanceKmTo(other : Location) : Double
}

class EnergyPrices {
  + petrolPerLitre : Double
  + dieselPerLitre : Double
  + lpgPerLitre : Double
  + electricityPerKwh : Double
  + hydrogenPerKg : Double
}

class User {
  + id : Int
  + name : String
  + email : String
  - passwordHash : String
  + bonusPoints : Int
  + checkPassword(password : String) : Boolean
  + addBonusPoints(points : Int)
  + canManage(car : Car) : Boolean
}

abstract class Car {
  + id : Int
  + brand : String
  + licensePlate : String
  + mileage : Int
  + status : CarStatus
  + rate : Double
  + location : Location
  + doors : Int
  + bodyStyle : BodyStyle
  + modelYear : Int
  + power : Int
  + transmission : Transmission
  + color : String
  + purchasePrice : Double
  + insurancePerYear : Double
  + roadTaxPerYear : Double
  + maintenancePerYear : Double
  + {abstract} costPerKm(prices : EnergyPrices) : Double
  + tcoPerYear(prices : EnergyPrices, kmPerYear : Int) : Double
  + isAvailable(date : LocalDate, daypart : Daypart) : Boolean
  + freeDayparts(date : LocalDate) : List<Daypart>
  + addImage(url : String) : Image
  + averageRating() : Double
}

class ICECar {
  + fuelType : FuelType
  + tankCapacityLitres : Double
  + consumptionLitresPer100Km : Double
  + costPerKm(prices : EnergyPrices) : Double
}

class BEVCar {
  + batteryCapacityKwh : Double
  + consumptionKwhPer100Km : Double
  + costPerKm(prices : EnergyPrices) : Double
}

class FCEVCar {
  + tankCapacityKg : Double
  + consumptionKgPer100Km : Double
  + costPerKm(prices : EnergyPrices) : Double
}

class Image {
  + id : Int
  + url : String
}

class Reservation {
  + id : Int
  + date : LocalDate
  + daypart : Daypart
  + status : ReservationStatus
  + recordTrip(distanceKm : Int, hardAccelerations : Int, hardBrakes : Int) : Trip
}

class Trip {
  + id : Int
  + distanceKm : Int
  + score : Int
  + {static} calculateScore(distanceKm : Int, hardAccelerations : Int, hardBrakes : Int) : Int
  + bonusPoints() : Int
}

class Rating {
  + id : Int
  + stars : Int
  + comment : String
}

class Organization {
  + id : Int
  + name : String
  + addMember(user : User, role : Role)
  + removeMember(user : User)
  + isAdmin(user : User) : Boolean
  + createInvite() : Invite
}

class Membership {
  + role : Role
}

class Invite {
  + code : String
  + expiresAt : LocalDateTime
  + used : Boolean
  + isValid(now : LocalDateTime) : Boolean
  + accept(user : User)
}

Car <|-- ICECar
Car <|-- BEVCar
Car <|-- FCEVCar

Car "0..*" --> "0..1" User : owner (private car)
Car "0..*" --> "0..1" Organization : (organization car)
Car "1" *-- "0..*" Image
Car ..> EnergyPrices
Reservation "0..*" --> "1" Car
Reservation "0..*" --> "1" User : renter
Trip "0..1" --> "1" Reservation
Rating "0..1" --> "1" Reservation : after the trip
User "0..*" -- "0..*" Organization
(User, Organization) .. Membership
Invite "0..*" --> "1" Organization

note "One active reservation per car, date and daypart.\nRESERVED -> COMPLETED (trip) or CANCELLED" as N1
N1 .. Reservation
note "A car has an owner or an organization, never both.\nOrganizations and invites are extra (#35–#38)" as N2
N2 .. Organization

@enduml
