@startuml RentACar
' Analysis view: the domain as agreed in the backlog, including parts that aren't built yet.
' For what the code looks like today, see class-diagram.puml.
hide empty members

enum Transmission {
  Manual
  Automatic
}

' Rented is gone: whether a car is rented depends on the daypart (#16).
enum CarStatus {
  Available
  Maintenance
}

enum BodyStyle {
  Hatchback
  SUV
  Sedan
  Stationwagon
  Cabrio
  Coupe
  MPV
  Other
}

enum FuelType {
  Petrol
  Diesel
  LPG
}

enum Daypart {
  Morning
  Afternoon
  Evening
}

enum Role {
  Admin
  Member
}

class Location {
  + latitude : Double
  + longitude : Double
}

class User {
  + id : Int
  + name : String
  + email : String
  - passwordHash : String
  + bonusPoints : Int
}

abstract class Car {
  + id : Int
  + brand : String
  + licensePlate : String
  + mileage : Int
  + status : CarStatus
  + rate : Double
  + location : Location
  + doors : Int
  + bodyStyle : BodyStyle
  + modelYear : Int
  + power : Int
  + transmission : Transmission
  + color : String
  + purchasePrice : Double
  + insurancePerYear : Double
  + roadTaxPerYear : Double
  + maintenancePerYear : Double
  + {abstract} costPerKm(prices : EnergyPrices) : Double
  + tcoPerYear(prices : EnergyPrices, kmPerYear : Int) : Double
}

class ICECar {
  + fuelType : FuelType
  + tankCapacityLitres : Double
  + consumptionLitresPer100Km : Double
  + costPerKm(prices : EnergyPrices) : Double
}

class BEVCar {
  + batteryCapacityKwh : Double
  + consumptionKwhPer100Km : Double
  + costPerKm(prices : EnergyPrices) : Double
}

class FCEVCar {
  + tankCapacityKg : Double
  + consumptionKgPer100Km : Double
  + costPerKm(prices : EnergyPrices) : Double
}

class Image {
  + id : Int
  + url : String
}

class Reservation {
  + id : Int
  + date : LocalDate
  + daypart : Daypart
}

class Trip {
  + id : Int
  + distanceKm : Int
  + score : Int
}

class Organization {
  + id : Int
  + name : String
}

class Membership {
  + role : Role
}

Car <|-- ICECar
Car <|-- BEVCar
Car <|-- FCEVCar

Car "0..*" --> "1" User : owner
Car "0..*" --> "0..1" Organization
Car "1" *-- "0..*" Image
Reservation "0..*" --> "1" Car
Reservation "0..*" --> "1" User : renter
Trip "0..1" --> "1" Reservation
User "0..*" -- "0..*" Organization
(User, Organization) .. Membership

note "One reservation per car, date and daypart" as N1
N1 .. Reservation
note "Organizations are extra (#35–#38)" as N2
N2 .. Organization

@enduml
