@startuml
' Use cases of the finished application, one per thing a person can do. Everything is also available in the console client.
left to right direction

actor Visitor
actor "User\n(logged in)" as User
actor Renter
actor Owner
actor "Organization member" as Member
actor "Organization admin" as Admin

Visitor <|-- User
User <|-- Renter
User <|-- Owner
User <|-- Member
Member <|-- Admin

rectangle "Rent-a-car" {
  usecase "Register" as UC_Register
  usecase "Log in" as UC_Login
  usecase "View and search cars\n(filter, sort, free on a daypart)" as UC_ViewCars
  usecase "View car details\nand photos" as UC_Details
  usecase "View ratings of a car" as UC_Ratings
  usecase "View availability" as UC_Availability
  usecase "View cost per km" as UC_CostPerKm
  usecase "Get a quote for a trip" as UC_Quote
  usecase "Compare cost and CO2\nof car types" as UC_Compare
  usecase "View leaderboard" as UC_Leaderboard

  usecase "Log out" as UC_Logout
  usecase "Update account" as UC_UpdateAccount
  usecase "Change password" as UC_ChangePassword
  usecase "Delete account" as UC_DeleteAccount
  usecase "Remove own cars" as UC_RemoveOwnCars
  usecase "Create organization" as UC_CreateOrg
  usecase "Accept invite" as UC_Accept
  usecase "View driving stats" as UC_Stats

  usecase "Reserve a car\nfor a daypart" as UC_Reserve
  usecase "View my reservations" as UC_MyReservations
  usecase "Cancel a reservation" as UC_Cancel
  usecase "Record a trip and\nearn bonus points" as UC_Trip
  usecase "Start and end a trip" as UC_StartEnd
  usecase "View my trip history" as UC_History
  usecase "Rate a car" as UC_Rate

  usecase "Add car" as UC_AddCar
  usecase "Update car" as UC_UpdateCar
  usecase "Remove car" as UC_RemoveCar
  usecase "Add photo" as UC_Photo
  usecase "View TCO" as UC_Tco
  usecase "Mark car as serviced" as UC_Service
  usecase "View trips of a car" as UC_CarTrips

  usecase "Manage organization cars" as UC_OrgCars
  usecase "Leave organization" as UC_Leave
  usecase "View organization report" as UC_Report
  usecase "Invite members" as UC_Invite
  usecase "Manage members" as UC_Members
  usecase "Remove organization car" as UC_OrgRemove
}

Visitor --> UC_Register
Visitor --> UC_Login
Visitor --> UC_ViewCars
Visitor --> UC_Details
Visitor --> UC_Ratings
Visitor --> UC_Availability
Visitor --> UC_CostPerKm
Visitor --> UC_Quote
Visitor --> UC_Compare
Visitor --> UC_Leaderboard
note right of UC_Login : After 5 failed logins for one email\nwithin 15 minutes: 429 until the\nwindow has passed

User --> UC_Logout
User --> UC_UpdateAccount
User --> UC_ChangePassword
User --> UC_DeleteAccount
User --> UC_CreateOrg
User --> UC_Accept
User --> UC_Stats
UC_DeleteAccount .> UC_RemoveOwnCars : <<include>>

Renter --> UC_Reserve
Renter --> UC_MyReservations
Renter --> UC_Cancel
Renter --> UC_Trip
Renter --> UC_StartEnd
Renter --> UC_History
Renter --> UC_Rate
UC_Reserve .> UC_Availability : <<include>>

Owner --> UC_AddCar
Owner --> UC_UpdateCar
Owner --> UC_RemoveCar
Owner --> UC_Photo
Owner --> UC_Tco
Owner --> UC_Service
Owner --> UC_CarTrips
UC_Tco .> UC_CostPerKm : <<include>>

Member --> UC_OrgCars
Member --> UC_Leave
Member --> UC_Report
UC_OrgCars .> UC_AddCar : <<extend>>
UC_OrgCars .> UC_UpdateCar : <<extend>>
Admin --> UC_Invite
Admin --> UC_Members
Admin --> UC_OrgRemove

@enduml
