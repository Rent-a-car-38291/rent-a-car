@startuml
' Use cases from the GitHub issues. Organization use cases are extras.
left to right direction

actor Visitor
actor "User\n(logged in)" as User
actor Renter
actor Owner
actor "Organization member" as Member
actor "Organization admin" as Admin

Visitor <|-- User
User <|-- Renter
User <|-- Owner
User <|-- Member
Member <|-- Admin

rectangle "Rent-a-car" {
  usecase "Register" as UC_Register
  usecase "Log in" as UC_Login
  usecase "View cars" as UC_ViewCars
  usecase "Filter cars by type,\nrate and distance" as UC_Filter
  usecase "Search cars free on\na date and daypart" as UC_FreeSearch
  usecase "View car details" as UC_Details
  usecase "View ratings of a car" as UC_Ratings

  usecase "Log out" as UC_Logout
  usecase "Update account" as UC_UpdateAccount
  usecase "Change password" as UC_ChangePassword
  usecase "Delete account" as UC_DeleteAccount
  usecase "Remove own cars" as UC_RemoveOwnCars
  usecase "Create organization" as UC_CreateOrg

  usecase "Reserve a car\nfor a daypart" as UC_Reserve
  usecase "View availability" as UC_Availability
  usecase "Cancel reservation" as UC_Cancel
  usecase "Record trip and\nearn bonus points" as UC_Trip
  usecase "Rate a car" as UC_Rate
  usecase "Start and end a trip" as UC_StartEnd
  usecase "View trip history" as UC_TripHistory
  usecase "View driving stats" as UC_Stats
  usecase "View leaderboard" as UC_Leaderboard
  usecase "View trips of\na car" as UC_CarTrips

  usecase "Add car" as UC_AddCar
  usecase "Update car" as UC_UpdateCar
  usecase "Remove car" as UC_RemoveCar
  usecase "Add photo" as UC_Photo
  usecase "View cost per km" as UC_CostPerKm
  usecase "View TCO" as UC_Tco

  usecase "Accept invite" as UC_Accept
  usecase "Manage organization cars" as UC_OrgCars
  usecase "Leave organization" as UC_Leave
  usecase "Invite members" as UC_Invite
  usecase "Manage members" as UC_Members
}

Visitor --> UC_Register
Visitor --> UC_Login
Visitor --> UC_ViewCars
Visitor --> UC_Details
UC_Filter .> UC_ViewCars : <<extend>>
UC_FreeSearch .> UC_ViewCars : <<extend>>

User --> UC_Logout
User --> UC_UpdateAccount
User --> UC_ChangePassword
User --> UC_DeleteAccount
User --> UC_CreateOrg
User --> UC_Accept
UC_DeleteAccount .> UC_RemoveOwnCars : <<include>>

Renter --> UC_Reserve
Renter --> UC_Cancel
Renter --> UC_Trip
Renter --> UC_Rate
UC_Rate .> UC_Trip : <<include>>
Visitor --> UC_Ratings
Renter --> UC_StartEnd
UC_StartEnd .> UC_Trip : <<extend>>
Renter --> UC_TripHistory
Renter --> UC_Stats
Visitor --> UC_Leaderboard
UC_Reserve .> UC_Availability : <<include>>

Owner --> UC_AddCar
Owner --> UC_UpdateCar
Owner --> UC_RemoveCar
Owner --> UC_Photo
Owner --> UC_CostPerKm
Owner --> UC_Tco
Owner --> UC_CarTrips
UC_Tco .> UC_CostPerKm : <<include>>

Member --> UC_OrgCars
Member --> UC_CarTrips
Member --> UC_Leave
Admin --> UC_Invite
Admin --> UC_Members

@enduml
