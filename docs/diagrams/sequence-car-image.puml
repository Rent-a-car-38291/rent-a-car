@startuml
title POST /cars/{id}/images
autonumber

actor Client
participant "Ktor\n(bearer authentication)" as Auth
participant "ImageRoutes.kt" as Route
participant "CarRepository" as Cars
participant "canManage" as Access
participant "ImageRepository" as Repo

Client -> Auth : POST /cars/{id}/images\nmultipart, part "file"
alt missing or invalid token
  Auth --> Client : 401 Unauthorized
else
  Auth -> Route : user
  alt id is not a number
    Route --> Client : 400 Bad Request
  else
    Route -> Cars : findCar(id)
    Cars --> Route : Car?
    alt unknown id
      Route --> Client : 404 Not Found
    else
      Route -> Access : canManage(user, car)
      alt owner, or member of the organization
        Route -> Route : read the part "file",\nat most 5 MB + 1 byte
        alt car already has 10 photos
          Route --> Client : 409 Conflict
        else no file part
          Route --> Client : 400 Bad Request
        else more than 5 MB
          Route --> Client : 413 Payload Too Large
        else first bytes are not JPEG or PNG
          Route --> Client : 400 Bad Request
        else
          Route -> Repo : add(carId, type, bytes)
          Repo -> Repo : write uploads/<random uuid>.<jpg|png>\ninsert the row with its url
          Repo --> Route : Image (null when the car was just deleted: 404)
          Route --> Client : 201 Created\n{id, carId, url}
        end
      else
        Route --> Client : 403 Forbidden
      end
    end
  end
end

@enduml
