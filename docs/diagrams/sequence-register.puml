@startuml
title POST /accounts (register)
autonumber

actor Client
participant "Ktor\n(ContentNegotiation)" as Ktor
participant "AccountRoutes.kt" as Route
participant UserRepository
database PostgreSQL

Client -> Ktor : POST /accounts\n{name, email, password}
Ktor -> Route : receive<RegisterRequest>()
break body unreadable
  Ktor --> Client : 400 / 415
end

Route -> Route : trim name and email
break name empty, email invalid or password < 8 chars
  Route --> Client : 400 Bad Request
end

Route -> UserRepository : register(name, email, password)
UserRepository -> UserRepository : hash(password)\nPBKDF2, random salt
UserRepository -> PostgreSQL : INSERT INTO users ...\nON CONFLICT DO NOTHING RETURNING *
alt email taken\n(unique index on lower(email))
  PostgreSQL --> UserRepository : no row
  UserRepository --> Route : null
  Route --> Client : 409 Conflict
else new email
  PostgreSQL --> UserRepository : new row
  UserRepository --> Route : User
  Route -> Route : user.toResponse()
  Route --> Client : 201 Created\n{id, name, email}
end

@enduml
