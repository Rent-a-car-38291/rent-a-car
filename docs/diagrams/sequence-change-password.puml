@startuml
title PUT /accounts/{id}/password
autonumber

actor Client
participant "Authentication\n(bearer)" as Auth
participant "AccountRoutes.kt" as Route
participant TokenRepository
participant UserRepository
database PostgreSQL

Client -> Auth : PUT /accounts/{id}/password\nAuthorization: Bearer <token>\n{ currentPassword, newPassword }
Auth -> TokenRepository : userId(token)
TokenRepository --> Auth : userId?
Auth -> UserRepository : find(userId)
UserRepository -> PostgreSQL : SELECT ... WHERE id = ?
UserRepository --> Auth : User?
break no token, unknown token or user deleted
  Auth --> Client : 401 Unauthorized
end
Auth -> Route : principal = User

Route -> Route : parameters.getOrFail<Int>("id")
break id not a number
  Route --> Client : 400 Bad Request
end

Route -> UserRepository : find(id)
UserRepository -> PostgreSQL : SELECT ... WHERE id = ?
UserRepository --> Route : User?
alt no user with that id
  Route --> Client : 404 Not Found
else id != principal.id
  Route --> Client : 403 Forbidden
end

Route -> Route : newPassword.length >= MIN_PASSWORD_LENGTH
break new password too short
  Route --> Client : 400 Bad Request
end

Route -> UserRepository : changePassword(id, currentPassword, newPassword)
UserRepository -> UserRepository : verify(currentPassword, passwordHash)
UserRepository -> PostgreSQL : UPDATE users SET password_hash = ?\nWHERE id = ? AND password_hash = <verified hash>
UserRepository --> Route : Boolean
break wrong current password
  Route --> Client : 403 Forbidden
end

Route -> TokenRepository : revokeAll(id, except = token)
note right : the other logins stop working,\nthe token of this request stays valid
Route --> Client : 204 No Content

@enduml
