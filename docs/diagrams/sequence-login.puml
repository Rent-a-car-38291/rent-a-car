@startuml
title POST /login
autonumber
skinparam maxMessageSize 170
skinparam wrapWidth 200

actor Client
participant "AccountRoutes.kt" as Route
participant UserRepository
database PostgreSQL
participant LoginLimiter
participant TokenRepository

Client -> Route : POST /login\n{email, password}
Route -> LoginLimiter : tryAcquire(email)\nchecks the lock and counts this attempt in one step,\nin memory, per email (trimmed, ignoring case)

alt 5 attempts without a success within 15 minutes
  LoginLimiter --> Route : seconds left
  Route --> Client : 429 Too Many Requests\nRetry-After: seconds\n(also for the correct password)
else not locked
LoginLimiter --> Route : null
Route -> UserRepository : authenticate(email.trim(), password)
UserRepository -> PostgreSQL : SELECT * FROM users\nWHERE lower(email) = lower(?)
PostgreSQL --> UserRepository : row?
UserRepository -> UserRepository : verify(password, passwordHash or dummyHash)\nre-hash with stored salt,\nconstant-time compare\n(unknown email: dummy hash, same time)

alt unknown email or wrong password
  UserRepository --> Route : null
  note right of Route : the attempt stays counted,\nunknown emails count too
  Route --> Client : 401 Unauthorized
else valid
  UserRepository --> Route : User
  Route -> LoginLimiter : reset(email)\nclears the count
  Route -> TokenRepository : issue(user.id)
  TokenRepository -> TokenRepository : random UUID, keep only sha256(token)
  TokenRepository -> PostgreSQL : DELETE expired rows,\nINSERT INTO tokens (token_hash, user_id,\nexpires_at = now + 7 days)
  TokenRepository --> Route : token
  Route --> Client : 200 OK\n{token}
end
end

@enduml
