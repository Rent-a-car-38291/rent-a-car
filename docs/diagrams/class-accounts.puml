@startuml
' The account classes as they are in src/. The car classes are in class-cars.puml.
hide empty members
set separator none

package com.example.accounts <<Folder>> {
  class "AccountRoutes.kt" as AccountRoutes <<(F,orchid) file>> {
    - MIN_PASSWORD_LENGTH : Int = 8
    - EMAIL_PATTERN : Regex
    - isValid(name : String, email : String) : Boolean
    - ApplicationCall.bearerToken() : String?
    + Application.configureAccounts(users : UserRepository, organizations : OrganizationRepository,\n  tokens : TokenRepository, loginLimiter : LoginLimiter)
  }
  class "Security.kt" as Security <<(F,orchid) file>> {
    + Application.configureSecurity(users : UserRepository, tokens : TokenRepository)
  }
  class User {
    + id : Int
    + name : String
    + email : String
    + passwordHash : String
    + bonusPoints : Int
    + toResponse() : UserResponse
  }
  class RegisterRequest <<data>> {
    + name : String
    + email : String
    + password : String
  }
  class UpdateAccountRequest <<data>> {
    + name : String
    + email : String
  }
  class ChangePasswordRequest <<data>> {
    + currentPassword : String
    + newPassword : String
  }
  class LoginRequest <<data>> {
    + email : String
    + password : String
  }
  class UserResponse <<data>> {
    + id : Int
    + name : String
    + email : String
    + bonusPoints : Int
  }
  class UserRepository {
    - dummyHash : String
    + register(name : String, email : String, password : String) : User?
    + authenticate(email : String, password : String) : User?
    + find(id : Int) : User?
    + update(id : Int, name : String, email : String) : User?
    + changePassword(id : Int, currentPassword : String, newPassword : String) : Boolean
    + delete(id : Int) : Boolean
    - hash(password : String, salt : ByteArray) : String
    - verify(password : String, passwordHash : String) : Boolean
  }
  class TokenRepository {
    - clock : Clock
    + issue(userId : Int) : String
    + userId(token : String) : Int?
    + revoke(token : String)
    + revokeAll(userId : Int, except : String? = null)
    - hash(token : String) : String
  }
  class LoginLimiter {
    - maxFailures : Int = 5
    - window : Duration = 15 minutes
    + tryAcquire(email : String) : Long?
    + lockedFor(email : String) : Long?
    + reset(email : String)
  }
  class Users <<table>> {
    id, name, email (unique, ignoring case)
    password_hash, bonus_points
  }
  class Tokens <<table>> {
    token_hash (SHA-256), user_id
    expires_at (7 days)
  }
}

UserRepository ..> User : reads and writes
UserRepository ..> Users
TokenRepository ..> Tokens
Tokens "0..*" --> "1" Users : user_id (cascade)
User ..> UserResponse : <<creates>>
AccountRoutes ..> RegisterRequest : receives
AccountRoutes ..> LoginRequest : receives
AccountRoutes ..> UpdateAccountRequest : receives
AccountRoutes ..> ChangePasswordRequest : receives
AccountRoutes ..> UserResponse : responds
AccountRoutes ..> User : principal
AccountRoutes ..> UserRepository
AccountRoutes ..> TokenRepository
AccountRoutes ..> LoginLimiter : 429 after 5 failures
Security ..> TokenRepository : userId(token)
Security ..> UserRepository : find(id)

@enduml
