@startuml
title POST /reservations/{id}/trip
autonumber
skinparam maxMessageSize 170
skinparam wrapWidth 200

actor Client
participant "Ktor\n(bearer authentication)" as Auth
participant "TripRoutes.kt" as Route
participant "ReservationRepository" as Reservations
participant "TripRepository" as Repo
database "trips\nUNIQUE (reservation_id)" as Db

Client -> Auth : POST /reservations/{id}/trip\n{distanceKm, hardAccelerations, hardBrakes}
alt missing or invalid token
  Auth --> Client : 401 Unauthorized
else
  Auth -> Route : user
  alt id is not a number
    Route --> Client : 400 Bad Request
  else
    Route -> Reservations : find(id)
    Reservations --> Route : Reservation?
    alt unknown id
      Route --> Client : 404 Not Found
    else reservation.userId != user.id
      Route --> Client : 403 Forbidden
    else a missing or non-integer field, a negative number,\ndistanceKm 0 or above 10000
      Route --> Client : 400 Bad Request
    else reservation.date is after today
      Route --> Client : 409 Conflict
    else
      Route -> Route : score = calculateScore(...)\npoints = bonusPoints(distanceKm, score)
      Route -> Repo : record(id, user.id, distanceKm, score, points)
      Repo -> Db : lock the reservation, INSERT trip (one transaction with the\nUPDATE reservations SET status = COMPLETED,\nUPDATE cars SET mileage += distanceKm and\nUPDATE users SET bonus_points += points)
      alt reservation already has a trip, it is cancelled,\nor its trip was started with /trip/start
        Db --> Repo : conflict, nothing inserted
        Repo --> Route : null
        Route --> Client : 409 Conflict
      else
        Db --> Repo : trip, new total
        Repo --> Route : Trip, bonusPoints
        Route --> Client : 201 Created\n{trip, pointsAwarded, bonusPoints}
      end
    end
  end
end

@enduml
