@startuml
title DELETE /reservations/{id}
autonumber

actor Client
participant "Ktor\n(bearer authentication)" as Auth
participant "ReservationRoutes.kt" as Route
participant "ReservationRepository" as Repo
database "reservations\ntrip_starts" as Db

Client -> Auth : DELETE /reservations/{id}
alt missing or invalid token
  Auth --> Client : 401 Unauthorized
else
  Auth -> Route : user
  alt id is not a number
    Route --> Client : 400 Bad Request
  else
    Route -> Repo : find(id)
    Repo --> Route : Reservation?
    alt unknown id
      Route --> Client : 404 Not Found
    else reservation.userId != user.id
      Route --> Client : 403 Forbidden
    else hasStarted(date, daypart, now)\nnow >= date at daypart.from (local time)
      Route --> Client : 409 Conflict
    else
      Route -> Repo : cancel(id)
      Repo -> Db : SELECT status FROM reservations FOR UPDATE,\nthen look for a started trip (one transaction)
      alt reservation is gone
        Repo --> Route : GONE
        Route --> Client : 404 Not Found
      else status is COMPLETED or CANCELLED,\nor the trip was started
        Repo --> Route : NOT_ALLOWED
        Route --> Client : 409 Conflict
      else
        Repo -> Db : UPDATE status = CANCELLED\n(the row is kept)
        Repo --> Route : CANCELLED
        Route --> Client : 204 No Content\n(the daypart is free again)
      end
    end
  end
end

@enduml
