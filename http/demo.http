###

# An unknown id
GET {{baseUrl}}/cars/999999999
Authorization: Bearer {{benToken}}

> {%
    client.test("404 Not Found", function () {
        client.assert(response.status === 404, "Expected 404 but got " + response.status);
        client.assert(response.body.error === "not_found", "Expected not_found, got " + response.body.error);
    });
%}

###

# Invalid input: an unknown car type in the filter
GET {{baseUrl}}/cars?type=xyz

> {%
    client.test("400 Bad Request", function () {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
        client.assert(response.body.error === "bad_request", "Expected bad_request, got " + response.body.error);
    });
%}

###

# Login is rate limited per email: five wrong passwords in a row, then even the right one is refused.
# A throwaway account, so the demo accounts stay usable.
< {%
    client.global.set("rateEmail", "rate" + client.global.get("runId") + "@example.com");
%}
POST {{baseUrl}}/accounts
Content-Type: application/json

{
  "name": "Dirk Smit",
  "email": "{{rateEmail}}",
  "password": "supersecret"
}

> {%
    client.test("201 Created", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
    });
%}

###

# Wrong password, attempt 1 of 5
POST {{baseUrl}}/login
Content-Type: application/json

{ "email": "{{rateEmail}}", "password": "wrong-password" }

> {% client.test("401 Unauthorized", function () { client.assert(response.status === 401, "Expected 401 but got " + response.status); }); %}

###

