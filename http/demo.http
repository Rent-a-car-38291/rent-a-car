###

# The sixth try, now with the right password: 429 with a Retry-After header (seconds)
POST {{baseUrl}}/login
Content-Type: application/json

{ "email": "{{rateEmail}}", "password": "supersecret" }

> {%
    client.test("429 Too Many Requests with Retry-After", function () {
        client.assert(response.status === 429, "Expected 429 but got " + response.status);
        var wait = parseInt(response.headers.valueOf("Retry-After"));
        client.assert(wait > 0 && wait <= 900, "Expected Retry-After between 1 and 900 seconds, got " + wait);
    });
%}
