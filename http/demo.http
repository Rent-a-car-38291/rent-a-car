###

# Ben's driving totals, calculated from his finished trips
GET {{baseUrl}}/accounts/{{benId}}/stats
Authorization: Bearer {{benToken}}

> {%
    client.test("1 trip, 120 km, average score 88, 105 points", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.tripCount === 1, "tripCount " + response.body.tripCount);
        client.assert(response.body.totalKm === 120, "totalKm " + response.body.totalKm);
        client.assert(response.body.averageScore === 88, "averageScore " + response.body.averageScore);
        client.assert(response.body.bestDaypart === "MORNING", "bestDaypart " + response.body.bestDaypart);
        client.assert(response.body.bonusPoints === 105, "bonusPoints " + response.body.bonusPoints);
    });
%}

