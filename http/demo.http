    client.test("one trip of 120 km with score 88", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.length === 1, "Expected one trip");
        client.assert(response.body[0].distanceKm === 120 && response.body[0].score === 88, "Wrong trip");
