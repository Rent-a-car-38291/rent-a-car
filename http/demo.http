###

# An organization car has no owner: it belongs to the company
POST {{baseUrl}}/cars
Authorization: Bearer {{annaToken}}
Content-Type: application/json

{
  "type": "BEV",
  "brand": "Tesla Model Y",
  "licensePlate": "ORG-{{runId}}",
  "mileage": 3000,
  "rate": 65,
  "location": { "latitude": 51.59, "longitude": 4.78 },
  "doors": 5,
  "bodyStyle": "SUV",
  "modelYear": 2024,
  "power": 150,
  "transmission": "Automatic",
  "color": "Black",
  "capacity": 75,
  "consumption": 16,
  "purchasePrice": 48000,
  "insurancePerYear": 1200,
  "roadTaxPerYear": 0,
  "maintenancePerYear": 700,
