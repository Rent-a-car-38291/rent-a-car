###

# End the trip: 120 km, 2 hard accelerations, 1 hard brake. The server calculates the score
# (100 minus 5 per hard action per 100 km, so 87.5, rounded to 88) and the points (120 x 88 / 100, rounded down)
POST {{baseUrl}}/reservations/{{reservationId}}/trip/end
Authorization: Bearer {{benToken}}
Content-Type: application/json

{
  "distanceKm": 120,
  "hardAccelerations": 2,
  "hardBrakes": 1
}

> {%
    client.test("201 Created, score 88 and 105 bonus points", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
        client.assert(response.body.trip.score === 88, "Score " + response.body.trip.score);
        client.assert(response.body.pointsAwarded === 105, "Points " + response.body.pointsAwarded);
        client.assert(response.body.bonusPoints === 105, "Total " + response.body.bonusPoints);
    });
%}

###

# A reservation with a trip can no longer be cancelled
DELETE {{baseUrl}}/reservations/{{reservationId}}
