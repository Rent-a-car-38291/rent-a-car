###

# Ben's reservations: the finished one is COMPLETED, the cancelled one is kept as CANCELLED
GET {{baseUrl}}/reservations
Authorization: Bearer {{benToken}}

> {%
    client.test("a COMPLETED and a CANCELLED reservation", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        var statuses = response.body.map(function (r) { return r.status; });
        client.assert(statuses.indexOf("COMPLETED") >= 0, "Expected COMPLETED in " + statuses);
        client.assert(statuses.indexOf("CANCELLED") >= 0, "Expected CANCELLED in " + statuses);
    });
%}

