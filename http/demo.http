# Rent my car: the REST API as user flows (IntelliJ HTTP Client).
#
# Start the server first (README: Getting started), pick the environment `dev` in the top right
# of the editor (it comes from http-client.env.json) and use "Run all requests in file", or run
# the requests one by one with the green arrow. Each block builds on the one before it: the token,
# the ids and the invite code are passed on with client.global.set, so nothing has to be copied.
# Every request checks its status code (and a key field where that is cheap) and shows green or red.
#
# It expects the sample fleet that the server puts into an empty database (13 cars, car 2 is the
# Tesla Model 3), so start from a clean database. Run the blocks in order: each block uses what the
# one before it saved.
#
# The file can run again on the same database: every run uses a new run id for the emails and the
# license plates, and a new car, so nothing it creates collides with an earlier run.
# Not tried here: cancelling a daypart that has just started (it depends on the time of day).

### Blok 1: Bezoeker (zonder inloggen)

# The cars: 200 and the number of matching cars in the header X-Total-Count
< {%
    // Run id for the emails and license plates, and today/tomorrow in Dutch time: the server decides
    // "today" in Europe/Amsterdam (UTC+1, UTC+2 from the last Sunday of March to the last Sunday of October).
    var now = new Date();
    var y = now.getUTCFullYear();
    function lastSunday(month) {
        var d = new Date(Date.UTC(y, month + 1, 0, 1, 0, 0));
        d.setUTCDate(d.getUTCDate() - d.getUTCDay());
        return d;
    }
    var offset = (now >= lastSunday(2) && now < lastSunday(9)) ? 2 : 1;
    function iso(ms) {
        var d = new Date(ms + offset * 3600000);
        function p(n) { return n < 10 ? "0" + n : "" + n; }
        return d.getUTCFullYear() + "-" + p(d.getUTCMonth() + 1) + "-" + p(d.getUTCDate());
    }
    client.global.clearAll(); // the IDE keeps globals between runs: start from nothing
    client.global.set("runId", String(now.getTime()));
    client.global.set("today", iso(now.getTime()));
    client.global.set("tomorrow", iso(now.getTime() + 24 * 3600000));
%}
GET {{baseUrl}}/cars?limit=5

> {%
    client.test("200 OK with a page of cars", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.length === 5, "Expected 5 cars but got " + response.body.length);
    });
    client.test("X-Total-Count holds the total", function () {
        client.assert(parseInt(response.headers.valueOf("X-Total-Count")) >= 13, "Expected at least 13 cars");
    });
    client.test("every car has a type", function () {
        response.body.forEach(function (car) {
            client.assert(["ICE", "BEV", "FCEV"].indexOf(car.type) >= 0, "Unknown type " + car.type);
        });
    });
%}

###

# Filter by type and rate, most expensive first (a minus before the sort field reverses it)
GET {{baseUrl}}/cars?type=BEV&maxRate=60&sort=-rate

> {%
    client.test("only electric cars up to 60, most expensive first", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.length > 0, "Expected some cars");
        for (var i = 0; i < response.body.length; i++) {
            client.assert(response.body[i].type === "BEV", "Not a BEV");
            client.assert(response.body[i].rate <= 60, "Rate above 60");
            if (i > 0) client.assert(response.body[i - 1].rate >= response.body[i].rate, "Not sorted descending");
        }
    });
%}

###

# Nearest first, within 50 km of Amsterdam (the first car is the nearest)
GET {{baseUrl}}/cars?lat=52.37&lon=4.90&maxDistanceKm=50

> {%
    client.test("200 OK, the Tesla Model 3 in Amsterdam comes first", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.length > 0, "Expected at least one car");
        client.assert(response.body[0].id === 2, "Expected car 2 (Amsterdam) first, got " + response.body[0].id);
    });
%}

###

# Only the cars that are free tomorrow afternoon (not reserved, not in maintenance)
GET {{baseUrl}}/cars?date={{tomorrow}}&daypart=AFTERNOON

> {%
    client.test("200 OK, the Ford Focus in maintenance (car 7) is left out", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        response.body.forEach(function (car) {
            client.assert(car.id !== 7 && car.status !== "Maintenance", "A car in maintenance is not free");
        });
        client.assert(response.body.length >= 12, "Expected the other cars to be free");
    });
%}

###

# Energy cost of one km: the seeded Tesla Model 3 (car 2) uses 14.5 kWh per 100 km at 0.35 per kWh
GET {{baseUrl}}/cars/2/cost-per-km

> {%
    client.test("0.0507 EUR per km", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.costPerKm === 0.0507, "Expected 0.0507 but got " + response.body.costPerKm);
        client.assert(response.body.currency === "EUR", "Expected EUR");
    });
%}

###

# A quote before reserving: energy for 120 km plus the rental rate of 55
GET {{baseUrl}}/cars/2/quote?distanceKm=120

> {%
    client.test("energy 6.09 plus rate 55.00 gives 61.09", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.energyCost === 6.09, "Energy cost " + response.body.energyCost);
        client.assert(response.body.rentalRate === 55, "Rate " + response.body.rentalRate);
        client.assert(response.body.total === 61.09, "Total " + response.body.total);
    });
%}

###

# Cost and CO2 per car type for 100 km: electric and hydrogen count as 0 kg at the tailpipe
GET {{baseUrl}}/cars/compare?distanceKm=100

> {%
    client.test("a row per type, electric emits nothing", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        var types = response.body.types.map(function (t) { return t.type; });
        client.assert(types.indexOf("BEV") >= 0 && types.indexOf("ICE") >= 0, "BEV and ICE expected, got " + types);
        response.body.types.forEach(function (t) {
            if (t.type === "BEV") client.assert(t.co2Kg === 0, "BEV CO2 should be 0");
        });
    });
%}

###

# The leaderboard is public and shows no email addresses (it is empty on a fresh database)
GET {{baseUrl}}/leaderboard

> {%
    client.test("200 OK, a list without email addresses", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        response.body.forEach(function (row) {
            client.assert(row.email === undefined, "The leaderboard must not show an email");
        });
    });
%}

### Blok 2: Account en auto (Anna)

# Anna registers: 201, and the password never comes back
< {%
    client.global.set("annaEmail", "anna" + client.global.get("runId") + "@example.com");
%}
POST {{baseUrl}}/accounts
Content-Type: application/json

{
  "name": "Anna Jansen",
  "email": "{{annaEmail}}",
  "password": "supersecret"
}

> {%
    client.test("201 Created, no password in the answer", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
        client.assert(response.body.password === undefined && response.body.passwordHash === undefined, "No password expected");
    });
    client.global.set("annaId", String(response.body.id));
%}

###

# Anna logs in and gets a token, which the next requests send as a bearer token
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{annaEmail}}",
  "password": "supersecret"
}

> {%
    client.test("200 OK with a token", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.token && response.body.token.length > 10, "Expected a token");
    });
    client.global.set("annaToken", response.body.token);
%}

###

# Anna offers an electric car with the costs of owning it (purchase 45000, insurance 900, road tax 0, maintenance 600)
POST {{baseUrl}}/cars
Authorization: Bearer {{annaToken}}
Content-Type: application/json

{
  "type": "BEV",
  "brand": "Polestar 2",
  "licensePlate": "AN-{{runId}}",
  "mileage": 12000,
  "rate": 49.5,
  "location": { "latitude": 51.59, "longitude": 4.78 },
  "doors": 5,
  "bodyStyle": "Hatchback",
  "modelYear": 2024,
  "power": 100,
  "transmission": "Automatic",
  "color": "Grey",
  "capacity": 78,
  "consumption": 17.5,
  "purchasePrice": 45000,
  "insurancePerYear": 900,
  "roadTaxPerYear": 0,
  "maintenancePerYear": 600
}

> {%
    client.test("201 Created, Anna owns the car", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
        client.assert(response.body.type === "BEV", "Expected a BEV");
        client.assert(String(response.body.ownerId) === client.global.get("annaId"), "Anna should be the owner");
    });
    client.global.set("carId", String(response.body.id));
%}

