###

# A photo (multipart): the type is read from the file itself, not from its name
POST {{baseUrl}}/cars/{{carId}}/images
Authorization: Bearer {{annaToken}}
Content-Type: multipart/form-data; boundary=DemoBoundary

--DemoBoundary
Content-Disposition: form-data; name="file"; filename="tiny.png"
Content-Type: image/png

< ./tiny.png
--DemoBoundary--

> {%
    client.test("201 Created with the url of the photo", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
        client.assert(response.body.url.indexOf("/images/") === 0, "Expected an /images/ url, got " + response.body.url);
    });
%}

